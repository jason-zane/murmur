<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>Voice Notes</string>
	<key>CFBundleDisplayName</key>
	<string>Voice Notes</string>
	<!-- Deliberately space-free and distinct from the existing app's `murmur`, so that
	     `pkill`/`killall` on either app can never match the other. -->
	<key>CFBundleExecutable</key>
	<string>Murmur</string>
	<!-- Separate from the existing Murmur's com.murmur.client: distinct TCC identity,
	     distinct preferences domain, no shared state of any kind. -->
	<key>CFBundleIdentifier</key>
	<string>com.jasonhunt.murmur</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<!-- Placeholders. `make app` stamps the version from the git tag, the build number
	     from the commit count, and VoiceNotesSiteURL from SITE_URL. -->
	<key>CFBundleShortVersionString</key>
	<string>0.5.0</string>
	<key>CFBundleVersion</key>
	<string>5</string>
	<!-- The hosted backend the app signs in to. Self-hosters build with their own. -->
	<key>VoiceNotesSiteURL</key>
	<string>https://murmur-rho-pied.vercel.app</string>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<!-- murmur://toggle, murmur://meeting, murmur://notes, murmur://sessions/<id>,
	     murmur://settings … — a scriptable way in from Shortcuts, a Stream Deck or a
	     mouse-button utility, and the OAuth callback (murmur://oauth/callback). -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.jasonhunt.murmur</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>murmur</string>
			</array>
		</dict>
	</array>
	<key>LSMinimumSystemVersion</key>
	<string>26.0</string>
	<!-- A regular app: dock icon, app menu, standard windows. The menu bar item remains
	     for status and the hotkey while you're working elsewhere, but it is secondary. -->
	<key>LSUIElement</key>
	<false/>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSMicrophoneUsageDescription</key>
	<string>Voice Notes listens while you hold the push-to-talk key so it can turn your speech into text.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Voice Notes transcribes your speech on-device to insert text where you're typing.</string>
	<!-- Meeting capture: a Core Audio process tap hears the far side of a call. This is the
	     "Audio Recording" grant, separate from the microphone. -->
	<key>NSAudioCaptureUsageDescription</key>
	<string>Voice Notes listens to the audio of a call so it can transcribe the other side of the conversation, on this Mac only.</string>
	<!-- Meeting detection: names sessions after the calendar event and seeds attendees.
	     Read-only; the Mac's own Calendar app does the syncing. -->
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>Voice Notes reads your calendar to name meetings and know who is in them. Nothing is written back.</string>
</dict>
</plist>
