# Copy to .env.local. Public values ship to the browser; the rest stay on the server.

# Your Supabase project (Project Settings ▸ API). The ref is the subdomain.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional: only needed if NEXT_PUBLIC_SUPABASE_URL isn't https://<ref>.supabase.co.
SUPABASE_PROJECT_REF=

# The https origin this deployment is served from, without a path. It becomes the
# Supabase Site URL, the OAuth redirect base and the MCP audience (<origin>/mcp).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set by configure-cloud.mjs once Google is configured.
NEXT_PUBLIC_GOOGLE_ENABLED=false
# The public OAuth client the Mac app signs in with. Written by configure-cloud.mjs.
MURMUR_DESKTOP_CLIENT_ID=

# Server only. Supabase secret key: encrypted Google Calendar credentials, account deletion.
SUPABASE_SECRET_KEY=
# 32 random bytes encoded as base64, e.g. openssl rand -base64 32.
# Also derives the booking rate-limit key. Changing it disconnects every calendar.
GOOGLE_TOKEN_ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Only for scripts/configure-cloud.mjs: a Supabase management token for this project,
# so it can set the Auth URLs, enable the OAuth server and the access-token hook.
MURMUR_SUPABASE_MANAGEMENT_TOKEN=
# Only for scripts/push-environment.mjs when your Vercel project lives in a team.
VERCEL_SCOPE=
